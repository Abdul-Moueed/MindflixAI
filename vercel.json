{
  "version": 2,
  "builds": [
    {
      "src": "dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/analyze-mood.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze-mood",
      "dest": "/api/analyze-mood.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}
